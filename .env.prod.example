# ===========================================
# Open WebUI Production Environment
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# GitHub username (for GHCR image reference)
GITHUB_USERNAME=your-github-username

# ===========================================
# Database Configuration
# ===========================================
DATABASE_USER=postgres
DATABASE_PASSWORD=your-secure-db-password-here
DATABASE_NAME=openwebui

# ===========================================
# Security (REQUIRED - generate a strong key)
# ===========================================
# Generate with: openssl rand -hex 32
# NOTE: In production, this value is stored in ./secrets/webui_secret_key.txt
#       and loaded via WEBUI_SECRET_KEY_FILE in docker-compose.prod.yaml.
#       You can remove this from .env after setting up secrets.
# WEBUI_SECRET_KEY=your-secret-key-here

# ===========================================
# Ollama Configuration
# ===========================================
# Docker image tag for Ollama (pin to specific version for reproducibility)
OLLAMA_DOCKER_TAG=v0.6.5
# If Ollama runs on host machine:
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ===========================================
# OpenAI-compatible API (optional)
# ===========================================
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# NOTE: OPENAI_API_KEY stays in .env (Open WebUI does not support _FILE for this).
# OPENAI_API_KEY=sk-...

# ===========================================
# Cloudflare Tunnel (Phase 2)
# ===========================================
# Get from: https://one.dash.cloudflare.com/ → Networks → Tunnels → Create
# NOTE: In production, this token is stored in ./secrets/cloudflare_tunnel_token.txt
#       and loaded via Docker secrets in docker-compose.prod.yaml.
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# ===========================================
# Microsoft Entra ID / OAuth (Phase 2)
# ===========================================
# Get from Azure Portal → Entra ID → App registrations
# MICROSOFT_CLIENT_ID=your-app-client-id
# MICROSOFT_CLIENT_SECRET=your-app-client-secret
# MICROSOFT_CLIENT_TENANT_ID=your-tenant-id

# ===========================================
# Telemetry (disabled)
# ===========================================
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# ===========================================
# Open Terminal
# ===========================================
# NOTE: In production, the API key is stored in ./secrets/open_terminal_api_key.txt
#       and loaded via OPEN_TERMINAL_API_KEY_FILE in docker-compose.prod.yaml.
OPEN_TERMINAL_API_KEY=your-open-terminal-api-key-here

# ===========================================
# Docker Compose Secrets (Production)
# ===========================================
# Sensitive values are stored in ./secrets/ files, not in .env.
# Create these files before deploying:
#   secrets/webui_secret_key.txt          - Open WebUI JWT signing key (generate: openssl rand -hex 32)
#   secrets/cloudflare_tunnel_token.txt   - Cloudflare Tunnel token
#   secrets/open_terminal_api_key.txt     - Open Terminal API key
#
# The following remain in .env (gitignored):
#   DATABASE_PASSWORD - PostgreSQL password
#   OPENAI_API_KEY - OpenAI API key (Open WebUI does not support _FILE for this)
