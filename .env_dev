# ===== Use for Local Development Mode =====
# ===== Docker Image Tags =====
OLLAMA_DOCKER_TAG=latest
WEBUI_DOCKER_TAG=main

# ===== Port Configuration =====
OPEN_WEBUI_PORT=8080  # Changed to match your running backend server

# ===== PostgreSQL Database =====
DATABASE_URL=postgresql://postgres:jamesram@localhost:5432/openwebui

# ===== Ollama Configuration =====
# For docker compose: use 'http://ollama:11434'
# For local development: use 'http://localhost:11434'
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=15m

# ===== WebUI Configuration =====
# CRITICAL: Generate a random secret key with PowerShell:
WEBUI_SECRET_KEY=t8K9mP2nL5qR3xW7vB4cF6hJ1dG8sA0z  # REPLACE THIS WITH YOUR GENERATED KEY
GLOBAL_LOG_LEVEL=DEBUG
RAG_LOG_LEVEL=DEBUG
ENV=dev
LOG_LEVEL=DEBUG

# ===== GPU Configuration (NVIDIA) =====
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ===== API Configuration =====
OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# ===== CORS & Network =====
# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='http://localhost:5173'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# ===== Telemetry =====
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# ===== Azure Settings =====
# ⚠️ WARNING: DO NOT COMMIT THIS FILE TO GIT WITH REAL CREDENTIALS!
AZURE_STORAGE_CONNECTION_STRING=''  # Add your connection string here (do not commit!)

# ===== Optional: Suppress Startup Warnings =====
AUDIO_STT_ENGINE=openai
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_VOICE=alloy
RAG_EMBEDDING_MODEL_AUTO_UPDATE=true
ENABLE_RAG_LOCAL_WEB_FETCH=true
YOUTUBE_LOADER_LANGUAGE=en